# === Bắt buộc ===
OPENAI_API_KEY=your-openai-api-key-here
VOYAGE_API_KEY=your-voyage-api-key-here

# === Tùy chọn (giá trị mặc định được hiển thị bên dưới) ===
# EMBEDDING_MODEL=text-embedding-3-large
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# RETRIEVER_K=5          # số kết quả cuối trả cho LLM (sau rerank)
# RETRIEVER_FETCH_K=20   # số kết quả thô lấy từ FAISS trước khi rerank
# VECTORSTORE_PATH=./vectorstore
# PAPERS_PATH=./data/papers
# BREAKPOINT_THRESHOLD=0.85
