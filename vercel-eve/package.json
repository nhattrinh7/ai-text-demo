    "@vercel/connect": "0.2.2",
    "ai": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "eve": "^0.20.0",
    "lucide-react": "^1.24.0",
    "next": "^15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
